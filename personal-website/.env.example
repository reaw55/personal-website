# Copy to .env.production (or set in the host's build settings).
# Everything prefixed VITE_ is embedded in the public JavaScript bundle,
# so NEVER put a secret here.

# Public address of the deployed contact relay (infra/contact-relay).
# Leave unset to keep posting the form straight to Getform.
# VITE_CONTACT_ENDPOINT=https://contact-relay.YOUR-ACCOUNT.workers.dev
